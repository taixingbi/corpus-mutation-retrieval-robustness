# Bedrock OpenAI-compatible chat (mutation + semantic judge)
# Resolve via: aws cloudformation describe-stacks --stack-name bedrock-inference-mvp ...
FACM_INFERENCE_URL=
FACM_INFERENCE_API_KEY=1234
FACM_INFERENCE_MODEL=openai.gpt-oss-120b-1:0

# ECS reranker service
# Resolve via: aws cloudformation describe-stacks --stack-name ecs-reranker-mvp ...
FACM_RERANK_URL=
FACM_RERANK_API_KEY=1234
